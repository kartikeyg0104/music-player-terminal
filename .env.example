# ---------------------------------------------------------------------------
# Termify — environment configuration
# Copy to `.env` (never commit `.env`) and fill in what you need.
# Every value below is OPTIONAL: with no .env at all Termify runs against the
# Internet Archive provider, which needs no credentials.
# ---------------------------------------------------------------------------

# --- Jamendo -----------------------------------------------------------------
# Free API. Register an application at https://devportal.jamendo.com/ and copy
# the "Client ID". Only the client id is needed for read-only search/streaming.
# Without it the Jamendo provider reports itself as unconfigured and is hidden.
JAMENDO_CLIENT_ID=

# --- Internet Archive --------------------------------------------------------
# No credentials required. These only tune behaviour.
# Contact string sent in the User-Agent, per archive.org's crawling etiquette.
ARCHIVE_CONTACT=
# Restrict searches to a collection (e.g. etree, audio_music, netlabels).
ARCHIVE_COLLECTION=

# --- Provider selection ------------------------------------------------------
# archive | jamendo | local | mock
TERMIFY_DEFAULT_PROVIDER=archive

# --- Local library -----------------------------------------------------------
# Absolute path to a folder of audio files. Leave empty to disable.
TERMIFY_MUSIC_DIR=

# --- Runtime -----------------------------------------------------------------
# Override where playlists/favourites/history/settings are stored.
# Defaults to ~/Library/Application Support/termify on macOS,
# $XDG_DATA_HOME/termify (or ~/.local/share/termify) elsewhere.
TERMIFY_DATA_DIR=

# error | warn | info | debug
TERMIFY_LOG_LEVEL=warn

# Force a specific audio backend instead of auto-detecting.
# mpv | ffplay | afplay | null
TERMIFY_AUDIO_BACKEND=

# Network timeout for provider requests, in milliseconds.
TERMIFY_HTTP_TIMEOUT_MS=12000

# --- Terminal overrides ------------------------------------------------------
# Set to any value to force the ASCII glyph set instead of Unicode symbols.
TERMIFY_ASCII=
# Set to any value to disable spinners and the visualizer animation.
TERMIFY_NO_ANIMATION=
